      <Association Name="Order_OrderReturn" Member="OrderReturns" ThisKey="OrderID" OtherKey="OrderID" Type="OrderReturn" />
      <Association Name="Order_OrderItem" Member="OrderItems" ThisKey="OrderID" OtherKey="OrderID" Type="OrderItem" />
