      <Column Name="CancellationDate" Type="System.DateTime" DbType="Date NOT NULL" CanBeNull="false" />
      <Column Name="CancellationReason" Type="System.String" DbType="Text NOT NULL" CanBeNull="false" UpdateCheck="Never" />
